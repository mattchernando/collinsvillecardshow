---
// UpcomingShows — static, data from shows.json.
// Show list + a subscribe panel that lets users (iOS, macOS, Android) sync the
// full show schedule to their phone calendar via the /shows.ics feed.
import shows from '../data/shows.json';

const SITE_URL = 'https://thecollinsvillecardshow.com';
const ICS_PATH = '/shows.ics';
const ICS_URL = `${SITE_URL}${ICS_PATH}`;

// Subscribe URLs — both point at the live /shows.ics feed so new dates flow through.
const webcalUrl = `webcal://${SITE_URL.replace(/^https?:\/\//, '')}${ICS_PATH}`;
const googleSubscribeUrl = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(
  ICS_URL,
)}`;
---

<section id="dates" class="py-24 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <div class="text-sm font-bold text-red-500 uppercase tracking-widest mb-4">Mark Your Calendar</div>
      <h2 class="text-4xl md:text-5xl font-black">
        Upcoming <span class="text-red-500">Shows</span>
      </h2>
    </div>

    <div class="space-y-3">
      {shows.map((show, i) => (
        <div
          class:list={[
            "group flex items-center justify-between p-5 rounded-2xl border transition-all cursor-default",
            i === 0
              ? "bg-gradient-to-r from-red-600/10 to-red-700/10 border-red-600/30"
              : "bg-gray-900 border-gray-800 hover:border-gray-700",
          ]}
        >
          <div class="flex items-center gap-4">
            <div
              class:list={[
                "w-12 h-12 rounded-xl flex items-center justify-center font-black text-lg",
                i === 0
                  ? "bg-gradient-to-br from-red-500 to-red-700 text-white"
                  : "bg-gray-800 text-gray-400",
              ]}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            </div>
            <div>
              <div class:list={["font-bold text-lg", i === 0 ? "text-red-500" : "text-white"]}>
                {show.date}
              </div>
              <div class="text-sm text-gray-500">{show.day} · 9 AM – 3 PM · Free Admission</div>
            </div>
          </div>
          {i === 0 && (
            <span class="hidden sm:inline-flex px-4 py-1.5 bg-red-600 text-white font-black text-xs rounded-full uppercase tracking-wider">
              Next Show
            </span>
          )}
        </div>
      ))}
    </div>

    {/* Subscribe panel — sync the entire show schedule to phone calendar */}
    <div class="mt-10 rounded-2xl border border-gray-800 bg-gradient-to-br from-gray-900 to-gray-950 p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-md">
          <div class="flex items-center gap-2 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12a10 10 0 0 1 10-10"/><path d="M2 12a10 10 0 0 0 10 10"/><path d="M12 2a10 10 0 0 1 10 10"/><circle cx="12" cy="12" r="3"/></svg>
            <h3 class="text-xl font-black text-white">Never miss a show</h3>
          </div>
          <p class="text-gray-400 text-sm leading-relaxed">
            Subscribe and every Collinsville Card Show date will appear on your phone — automatically updated when new shows are scheduled. Works with Apple Calendar, Google Calendar, and Outlook.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row md:flex-col lg:flex-row gap-2 sm:gap-3 shrink-0">
          <a
            href={webcalUrl}
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-white text-gray-900 hover:bg-gray-100 transition-colors"
            aria-label="Subscribe with Apple Calendar"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.86-3.08.42-1.09-.46-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.42C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
            Apple Calendar
          </a>
          <a
            href={googleSubscribeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-red-600 text-white hover:bg-red-500 transition-colors"
            aria-label="Subscribe with Google Calendar"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            Google Calendar
          </a>
          <a
            href={ICS_PATH}
            download="collinsville-card-show.ics"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-gray-800 text-gray-200 hover:bg-gray-700 border border-gray-700 transition-colors"
            aria-label="Download iCalendar (.ics) file"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Download .ics
          </a>
        </div>
      </div>

      <div class="mt-5 pt-5 border-t border-gray-800/80 text-xs text-gray-500 leading-relaxed">
        <span class="font-semibold text-gray-400">On Android?</span> Tap <span class="text-gray-300">Google Calendar</span> above. <span class="font-semibold text-gray-400">On iPhone?</span> Tap <span class="text-gray-300">Apple Calendar</span> — it'll prompt you to subscribe in the Calendar app.
      </div>
    </div>
  </div>
</section>

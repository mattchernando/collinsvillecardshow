---
// LandingInternalLinks — pill-style cross-link bar for landing pages.
// Pages pass a list of {label, href} so each page can omit its own link.

interface Link {
  label: string;
  href: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

<section class="py-12 px-4">
  <div class="max-w-4xl mx-auto flex flex-wrap gap-4 justify-center text-sm">
    {links.map((link) => (
      <a
        href={link.href}
        class="px-4 py-2 bg-gray-900 border border-gray-800 rounded-full text-gray-400 hover:text-red-500 hover:border-red-600/50 transition-all font-semibold"
      >
        {link.label}
      </a>
    ))}
  </div>
</section>

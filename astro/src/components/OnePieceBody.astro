---
// OnePieceBody — page-specific body sections for /one-piece-tcg-card-show-illinois.
// Mirrors PokemonBody's structure: intro prose, product grid, audience section, dates.
import LandingShowDates from './LandingShowDates.astro';

const productCategories = [
  { name: 'Booster Boxes', emoji: '📦' },
  { name: 'Starter Decks', emoji: '🎴' },
  { name: 'Singles & Rares', emoji: '✨' },
  { name: 'Alternate Arts', emoji: '🎨' },
  { name: 'Leader Cards', emoji: '👑' },
  { name: 'Sealed Cases', emoji: '🗳️' },
  { name: 'Tournament Promos', emoji: '🏆' },
  { name: 'Sleeves & Playmats', emoji: '🎒' },
  { name: 'Bulk Lots', emoji: '📚' },
];
---

<section class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-black mb-8">
      What <span class="text-red-500">One Piece TCG</span> Fans Will Find
    </h2>

    <div class="text-gray-400 text-lg leading-relaxed space-y-6 mb-12">
      <p>
        One Piece TCG has exploded in popularity, and the <a href="/" class="text-red-500 hover:underline">Collinsville Card Show</a> is one of the best places in the St. Louis Metro East to find product in person. Whether you're chasing alternate-art Leaders, building out a competitive deck, or hunting sealed product to crack or hold, you'll find vendors with dedicated One Piece inventory at every show.
      </p>
      <p>
        Our vendors carry sealed booster boxes, starter decks, and cases from the latest sets, plus singles ranging from common chase cards to high-end alternate arts and tournament promos. You'll also find sleeves, deck boxes, and playmats themed for the OP TCG. Pricing is competitive and trade is welcome.
      </p>
    </div>

    <!-- Product categories grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-12">
      {productCategories.map((item) => (
        <div class="p-4 bg-gray-900 border border-gray-800 rounded-xl hover:border-red-600/50 transition-colors">
          <span class="text-2xl">{item.emoji}</span>
          <div class="font-bold text-sm text-gray-300 mt-2">{item.name}</div>
        </div>
      ))}
    </div>

    <h2 class="text-3xl md:text-4xl font-black mb-6">
      Great for <span class="text-red-500">Players & Collectors</span>
    </h2>
    <div class="text-gray-400 text-lg leading-relaxed space-y-6">
      <p>
        One Piece TCG draws an enthusiastic crowd at every show — local players looking to round out decks, collectors chasing alt arts, and newer fans picking up their first starter. With the game still growing in the U.S. market, in-person events like the Collinsville Card Show are one of the best ways to meet other players and find product without paying online markups.
      </p>
      <p>
        Admission is always free, parking is free, and the show runs from 9 AM to 3 PM — plenty of time to dig through binders and trade with other fans. We're located at The Crossings Church, 2002 Mall Street, Collinsville, IL 62234, just minutes from St. Louis.
      </p>
    </div>

    <!-- Upcoming dates -->
    <div class="mt-12">
      <LandingShowDates timeLabel="9 AM – 3 PM · Free" linkText="View full show details" />
    </div>
  </div>
</section>

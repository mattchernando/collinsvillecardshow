---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LandingHero from '../components/LandingHero.astro';
import PokemonBody from '../components/PokemonBody.astro';
import LandingFAQ from '../components/LandingFAQ.astro';
import LandingInternalLinks from '../components/LandingInternalLinks.astro';
import LandingCTA from '../components/LandingCTA.astro';
import Footer from '../components/Footer.astro';
import {
  SITE_URL,
  buildBreadcrumbSchema,
  buildFAQSchema,
} from '../data/seo';

const title = "Pokémon Card Show in Illinois | Collinsville Card Show Near St. Louis";
const description = "Find Pokémon cards, sealed product, booster boxes, graded slabs, and more at the Collinsville Card Show in Illinois. Monthly event near St. Louis with free admission. Vendors carry the latest sets and vintage Pokémon collectibles.";

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Pokémon Card Show Illinois', url: `${SITE_URL}/pokemon-card-show-illinois/` },
]);

const schemaFAQ = [
  {
    question: "Where can I buy Pokémon cards in person in Illinois?",
    answer: "The Collinsville Card Show features multiple vendors who specialize in Pokémon TCG products. You'll find everything from the latest booster boxes and elite trainer boxes to vintage base set cards and graded slabs. We're held monthly in Collinsville, IL, near St. Louis.",
  },
  {
    question: "Is there a Pokémon card show near St. Louis?",
    answer: "Yes! The Collinsville Card Show in Collinsville, IL is just 10 minutes from downtown St. Louis and features numerous Pokémon TCG vendors every month. Admission and parking are free.",
  },
  {
    question: "Can kids trade Pokémon cards at the show?",
    answer: "Absolutely! The Collinsville Card Show is a family-friendly, all-ages event. Kids are welcome to browse, buy, and trade Pokémon cards. It's a great way to spend a Saturday together.",
  },
  {
    question: "What Pokémon products can I find at the show?",
    answer: "Vendors carry a wide range of Pokémon TCG products including booster packs, booster boxes, elite trainer boxes, sealed collections, individual singles, graded cards (PSA, CGC, BGS), Japanese Pokémon products, binders, sleeves, and accessories.",
  },
];

const faq = buildFAQSchema(schemaFAQ);

// On-page FAQ — preserves the existing trimmed display copy that differs from
// the structured-data version above.
const displayFAQ = [
  {
    question: "Where can I buy Pokémon cards in person in Illinois?",
    answer: "The Collinsville Card Show features multiple vendors who specialize in Pokémon TCG products. You'll find everything from the latest booster boxes to vintage base set cards and graded slabs. We're held monthly in Collinsville, IL, near St. Louis.",
  },
  {
    question: "Can kids trade Pokémon cards at the show?",
    answer: "Absolutely! The Collinsville Card Show is a family-friendly, all-ages event. Kids are welcome to browse, buy, and trade Pokémon cards.",
  },
  {
    question: "What Pokémon products can I find at the show?",
    answer: "Vendors carry booster packs, booster boxes, elite trainer boxes, sealed collections, individual singles, graded cards (PSA, CGC, BGS), Japanese Pokémon products, binders, sleeves, and accessories.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE_URL}/pokemon-card-show-illinois/`}
  extraSchema={[breadcrumb, faq]}
>
  <Nav />
  <LandingHero
    badge="POKÉMON TCG VENDORS EVERY SHOW"
    badgeEmoji="⚡"
    title='<span class="text-red-500">Pokémon</span> Card Show in Illinois'
    description="From the latest booster boxes to vintage base set cards, the Collinsville Card Show is the place to find Pokémon TCG products in Southern Illinois. Held monthly near St. Louis with free admission."
    theme="pokemon"
  />
  <PokemonBody />
  <LandingFAQ
    items={displayFAQ}
    headlinePre="Pokémon Card Show"
    headlineHighlight="FAQ"
    bgClass="bg-gray-900/50"
  />
  <LandingInternalLinks
    links={[
      { label: 'Collinsville Card Show Home', href: '/' },
      { label: 'Card Show Near St. Louis', href: '/st-louis-card-show/' },
      { label: 'Magic: The Gathering Card Show', href: '/magic-the-gathering-card-show-illinois/' },
      { label: 'One Piece TCG Card Show', href: '/one-piece-tcg-card-show-illinois/' },
      { label: 'Vendor Tables', href: '/vendor-tables/' },
    ]}
  />
  <LandingCTA
    headline="Come Find Your Next Pull"
    body="Free admission, free parking, and Pokémon vendors at every show. Bring the family and start collecting."
  />
  <Footer />
</BaseLayout>

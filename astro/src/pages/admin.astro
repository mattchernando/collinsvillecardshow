  <main class="py-10 px-4">
    <div class="max-w-6xl mx-auto">
      <a href="https://thecollinsvillecardshow.com/" class="text-sm text-gray-500 hover:text-red-500">&larr; thecollinsvillecardshow.com</a>
      <div class="mt-4">
        <AdminDashboard client:load />
      </div>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LandingHero from '../components/LandingHero.astro';
import StLouisBody from '../components/StLouisBody.astro';
import LandingFAQ from '../components/LandingFAQ.astro';
import LandingInternalLinks from '../components/LandingInternalLinks.astro';
import LandingCTA from '../components/LandingCTA.astro';
import Footer from '../components/Footer.astro';
import {
  SITE_URL,
  buildBreadcrumbSchema,
  buildFAQSchema,
} from '../data/seo';

const title = "Card Show Near St. Louis | Collinsville Card Show — Monthly in Collinsville, IL";
const description = "Looking for a card show near St. Louis? The Collinsville Card Show is held monthly in Collinsville, IL — just 10 minutes from downtown STL. Free admission, 100 vendor tables, sports cards, Pokémon, collectibles and more.";

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Card Show Near St. Louis', url: `${SITE_URL}/st-louis-card-show/` },
]);

const schemaFAQ = [
  {
    question: "Where is the closest card show to St. Louis?",
    answer: "The Collinsville Card Show is held just 10 minutes east of downtown St. Louis in Collinsville, IL. It's the closest recurring card show to the St. Louis metro area, with easy access from I-55 and I-70.",
  },
  {
    question: "How do I get to the Collinsville Card Show from St. Louis?",
    answer: "Take I-55/I-70 East across the river into Illinois. The venue — The Crossings Church at 2002 Mall Street, Collinsville, IL 62234 — is right off the interstate, about a 10-minute drive from downtown St. Louis.",
  },
  {
    question: "Is the St. Louis area card show free?",
    answer: "Yes! Admission and parking are completely free at the Collinsville Card Show. Just show up and enjoy.",
  },
  {
    question: "How often is there a card show near St. Louis?",
    answer: "The Collinsville Card Show runs monthly on Saturdays, typically once a month throughout the year. Check our homepage for the next scheduled date.",
  },
];

const faq = buildFAQSchema(schemaFAQ);

// On-page FAQ — preserves the existing trimmed display copy that differs slightly
// from the schema answers above.
const displayFAQ = [
  {
    question: "Where is the closest card show to St. Louis?",
    answer: "The Collinsville Card Show is held just 10 minutes east of downtown St. Louis in Collinsville, IL. It's the closest recurring card show to the St. Louis metro area, with easy access from I-55 and I-70.",
  },
  {
    question: "How do I get there from St. Louis?",
    answer: "Take I-55/I-70 East across the river into Illinois. The venue — The Crossings Church at 2002 Mall Street, Collinsville, IL 62234 — is right off the interstate.",
  },
  {
    question: "Is the St. Louis area card show free?",
    answer: "Yes! Admission and parking are completely free at the Collinsville Card Show.",
  },
  {
    question: "How often is there a card show near St. Louis?",
    answer: 'The Collinsville Card Show runs monthly on Saturdays. Check our <a href="/" class="text-red-500 hover:underline">homepage</a> for upcoming dates.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE_URL}/st-louis-card-show/`}
  extraSchema={[breadcrumb, faq]}
>
  <Nav />
  <LandingHero
    badge="JUST 10 MINUTES FROM DOWNTOWN STL"
    title='The Best <span class="text-red-500">Card Show</span> Near St. Louis'
    description="Looking for a sports card show, Pokémon card event, or trading card show in the St. Louis area? The Collinsville Card Show has you covered — held monthly in Collinsville, IL with free admission, free parking, and 100 vendor tables."
    theme="red"
  />
  <StLouisBody />
  <LandingFAQ
    items={displayFAQ}
    headlinePre="St. Louis Card Show"
    headlineHighlight="FAQ"
  />
  <LandingInternalLinks
    links={[
      { label: 'Collinsville Card Show Home', href: '/' },
      { label: 'Pokémon Card Show Illinois', href: '/pokemon-card-show-illinois' },
      { label: 'Magic: The Gathering Card Show', href: '/magic-the-gathering-card-show-illinois' },
      { label: 'One Piece TCG Card Show', href: '/one-piece-tcg-card-show-illinois' },
      { label: 'Vendor Tables', href: '/vendor-tables' },
    ]}
  />
  <LandingCTA
    headline="Ready to Come Out?"
    body="Free admission, free parking, and 100 vendor tables of cards and collectibles. The next show is just around the corner."
  />
  <Footer />
</BaseLayout>

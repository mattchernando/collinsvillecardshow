---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LandingHero from '../components/LandingHero.astro';
import MagicBody from '../components/MagicBody.astro';
import LandingFAQ from '../components/LandingFAQ.astro';
import LandingInternalLinks from '../components/LandingInternalLinks.astro';
import LandingCTA from '../components/LandingCTA.astro';
import Footer from '../components/Footer.astro';
import {
  SITE_URL,
  buildBreadcrumbSchema,
  buildFAQSchema,
} from '../data/seo';

const title = "Magic: The Gathering Card Show in Illinois | Collinsville Card Show Near St. Louis";
const description = "Find Magic: The Gathering singles, booster boxes, Commander decks, foils, and Reserved List cards at the Collinsville Card Show in Illinois. Monthly MTG-friendly event near St. Louis with free admission and dozens of vendors.";

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Magic: The Gathering Card Show Illinois', url: `${SITE_URL}/magic-the-gathering-card-show-illinois/` },
]);

const schemaFAQ = [
  {
    question: "Where can I buy Magic: The Gathering cards in person in Illinois?",
    answer: "The Collinsville Card Show features multiple vendors who carry Magic: The Gathering product. You'll find sealed booster boxes, Commander precons, singles spanning Standard through Legacy and Commander, foils, promos, and Reserved List cards. We're held monthly in Collinsville, IL, near St. Louis.",
  },
  {
    question: "Is there a Magic: The Gathering card show near St. Louis?",
    answer: "Yes! The Collinsville Card Show in Collinsville, IL is just 10 minutes from downtown St. Louis and consistently features Magic: The Gathering vendors every month. Admission and parking are free.",
  },
  {
    question: "What Magic formats are vendors stocked for?",
    answer: "Vendors at the Collinsville Card Show typically carry singles for Standard, Pioneer, Modern, Legacy, and Commander, plus sealed product from the latest sets. Many sellers also carry Reserved List cards, vintage dual lands, foils, and Collector Booster product.",
  },
  {
    question: "Can I trade or sell my MTG cards at the show?",
    answer: "Many vendors at the Collinsville Card Show buy and trade Magic cards in addition to selling. Bring your binder and ask — most are happy to discuss trades or offers, especially for high-demand singles and sealed product.",
  },
];

const faq = buildFAQSchema(schemaFAQ);

// On-page FAQ — slightly trimmed display copy.
const displayFAQ = [
  {
    question: "Where can I buy Magic: The Gathering cards in person in Illinois?",
    answer: "The Collinsville Card Show features multiple vendors who carry MTG product. You'll find sealed boxes, Commander precons, singles across all formats, foils, promos, and Reserved List cards. We're held monthly in Collinsville, IL, near St. Louis.",
  },
  {
    question: "What Magic formats are vendors stocked for?",
    answer: "Vendors typically carry singles for Standard, Pioneer, Modern, Legacy, and Commander, plus sealed product from the latest sets. Reserved List, foils, and Collector Booster product are common too.",
  },
  {
    question: "Can I trade or sell my MTG cards at the show?",
    answer: "Many vendors buy and trade MTG cards in addition to selling. Bring your binder and ask — most are happy to discuss trades or offers, especially for high-demand singles and sealed product.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE_URL}/magic-the-gathering-card-show-illinois/`}
  extraSchema={[breadcrumb, faq]}
>
  <Nav />
  <LandingHero
    badge="MTG VENDORS EVERY SHOW"
    badgeEmoji="🪄"
    title='<span class="text-red-500">Magic: The Gathering</span> Card Show in Illinois'
    description="From Standard staples to Reserved List dual lands, the Collinsville Card Show is the place to find Magic: The Gathering product in Southern Illinois. Held monthly near St. Louis with free admission."
    theme="mtg"
  />
  <MagicBody />
  <LandingFAQ
    items={displayFAQ}
    headlinePre="Magic: The Gathering"
    headlineHighlight="FAQ"
    bgClass="bg-gray-900/50"
  />
  <LandingInternalLinks
    links={[
      { label: 'Collinsville Card Show Home', href: '/' },
      { label: 'Card Show Near St. Louis', href: '/st-louis-card-show/' },
      { label: 'Pokémon Card Show Illinois', href: '/pokemon-card-show-illinois/' },
      { label: 'One Piece TCG Card Show', href: '/one-piece-tcg-card-show-illinois/' },
      { label: 'Vendor Tables', href: '/vendor-tables/' },
    ]}
  />
  <LandingCTA
    headline="Find Your Next Staple"
    body="Free admission, free parking, and MTG vendors at every show. Build your deck, finish your Commander list, or hunt that Reserved List card in person."
  />
  <Footer />
</BaseLayout>
